0.31845373, 0.32411948, 0.32975328, 0.33535555, 0.3409266, 0.34646678, 0.35197642, 0.35745588,
0.3629055, 0.36832556, 0.3737164, 0.37907836, 0.3844117, 0.38971674, 0.3949938, 0.40024316,
0.4054651, 0.41065994, 0.4158279, 0.4209693, 0.4260844, 0.43117347, 0.43623677, 0.44127455,
0.4462871, 0.45127463, 0.45623744, 0.4611757, 0.46608973, 0.47097972, 0.4758459, 0.48068854,
0.48550782, 0.490304, 0.49507725, 0.49982786, 0.504556, 0.5092619, 0.51394576, 0.51860774,
0.52324814, 0.5278671, 0.5324648, 0.5370415, 0.5415973, 0.54613245, 0.55064714, 0.5551415,
0.5596158, 0.56407017, 0.56850475, 0.5729197, 0.5773154, 0.58169174, 0.586049, 0.59038746,
0.59470713, 0.5990082, 0.60329086, 0.60755527, 0.61180156, 0.61602986, 0.6202404, 0.6244333,
0.62860864, 0.63276666, 0.63690746, 0.6410312, 0.64513797, 0.6492279, 0.6533013, 0.65735805,
0.6613985, 0.6654226, 0.6694307, 0.6734227, 0.6773988, 0.68135923, 0.685304, 0.6892333
