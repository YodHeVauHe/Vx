0.3028848683749714, 0.9110320284697531, -0.25936854903069645, -0.1782043459350474, 0.1942480283297007, 0.008926940501244813, -0.12221407250593548, 0.053690574237112404, 0.05708124716885467,
0.35877067027057225, 0.8767123287671252, -0.28823419027995, -0.12985893506891621, 0.1903892581719267, -0.03184050927546089, -0.09383267667924, 0.07268806018221548, 0.020680792699332852,
0.4124104415973873, 0.8393442622950833, -0.3082182209085838, -0.08392389966931191, 0.17557753337991408, -0.06089430185201959, -0.060979210117700314, 0.07480096866799445, -0.00912444833801258,
0.4636476090008061, 0.8000000000000007, -0.3199999999996957, -0.04266666667605661, 0.15359999889982473, -0.0778239658747293, -0.03003587524248839, 0.0650216697636172, -0.028137145735138053,
0.5123894603107377, 0.7596439169139467, -0.3245956202840571, -0.007420143865676024, 0.1280444834291926, -0.08415938485361943, -0.004911839804021753, 0.04925441732576568, -0.03316592632070903,
0.5585993153435624, 0.7191011235955054, -0.3231915162227742, 0.021304010061479053, 0.10184143753536261, -0.08242614694536879, 0.012919164973409272, 0.03240065138755702, -0.03223937624428669,
0.6022873461349642, 0.6790450928381959, -0.3170077886985954, 0.04362328866799965, 0.07708341693828792, -0.0753507567406053, 0.023734953728903288, 0.017581583432851745, -0.027346405912995427,
0.6435011087932844, 0.6399999999999996, -0.30719999999978287, 0.06007466667246697, 0.05505023919687492, -0.06534727757601048, 0.028790802954853607, 0.006212149264184137, -0.019516816040973287,
0.6823165548747481, 0.6023529411764702, -0.29479861591685924, 0.07142752588877758, 0.0363501990827262, -0.054279110952172305, 0.029678103967826764, -0.0015207345678007842, -0.01231452346046495,
0.7188299996216245, 0.566371681415929, -0.2806797713214607, 0.07853829252651727, 0.02110209054585545, -0.04342140830045491, 0.027895069123844596, -0.006115180598091626, -0.005873713374935217,
0.7531512809621944, 0.532224532224532, -0.26555901815810123, 0.0822502960399653, 0.009109040198374876, -0.033537465532893516, 0.024656086282221525, -0.008329021593801292, -0.0018123755428003157,
0.7853981633974483, 0.4999999999999999, -0.24999999999958156, 0.0833333333348498, -0.0000000015443557967224647, -0.025000005591068682, 0.020835445851408983, -0.00892093816649993, -0.0009662780908537286
