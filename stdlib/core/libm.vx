0.06241880999595734, 0.9961089494163397, -0.06201456494402331, -0.3255965744024295, 0.061292536383593, 0.18849224712259213, -0.06025927907046346, -0.12748113406685765, 0.058009756061519,
0.12435499454676144, 0.9846153846153832, -0.12118343195267112, -0.30326930661093005, 0.11564771534174335, 0.15638839908597052, -0.10799176709240983, -0.08710349113750157, 0.09825499943113183,
0.18534794999569476, 0.9660377358490569, -0.17498042007825676, -0.2688168801581556, 0.15755588328557993, 0.11015088672637323, -0.13472259344941245, -0.03419439719338726, 0.10811626401213925,
