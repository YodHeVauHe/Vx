// Math functions written in Vx, ported from LLVM libc (llvm-project, libc/src/__support/math/,
// Apache-2.0 WITH LLVM-exception) at commit f475f085bf7b. `core::num`'s float methods call these
// instead of the platform libm (Vx#1038).
//
// Each function follows its C++ source step for step, so that it gives the same bits; the
// file it comes from is named above it. Three things differ:
// - Constants are written as their exact bit patterns, `libm_f64_from_bits(..)`, with LLVM's hex
//   float in a comment: Vx has no hex float literals yet (Vx#783).
// - Table entries are written as decimals: the shortest with the same bits as LLVM's hex float.
// - Only the FMA branch of each `#ifdef LIBC_TARGET_CPU_HAS_FMA_DOUBLE` is kept, because
//   `mul_add` is always fused in Vx. Floating-point exceptions and `errno` are not set, and
//   only round-to-nearest is supported, so LLVM's `round_result_slightly_up/down` cases
//   return their constant directly.
//
// Every function's name starts with `libm_`: Vx has one namespace for all functions and no
// private ones yet, so a program's own `asinhf` must not collide with these.
//
// This module imports only `core::marker`, which imports nothing, so that `core::num` can import
// it: the few operations it needs on floats are the helpers below, each one MLIR operation.
import core::marker;

fn libm_f64_to_bits(x : f64) -> u64 {
  return mlir!( inputs : (%a = x : f64), returns : u64, dialects : ["arith"]) {
    %r = "arith.bitcast"(%a) : (f64) -> i64
    macro.yield %r : i64
  };
}

fn libm_f64_from_bits(v : u64) -> f64 {
  return mlir!( inputs : (%v = v : i64), returns : f64, dialects : ["arith"]) {
    %r = "arith.bitcast"(%v) : (i64) -> f64
    macro.yield %r : f64
  };
}

fn libm_f32_to_bits(x : f32) -> u32 {
  return mlir!( inputs : (%a = x : f32), returns : u32, dialects : ["arith"]) {
    %r = "arith.bitcast"(%a) : (f32) -> i32
    macro.yield %r : i32
  };
}

fn libm_f32_from_bits(v : u32) -> f32 {
  return mlir!( inputs : (%v = v : i32), returns : f32, dialects : ["arith"]) {
    %r = "arith.bitcast"(%v) : (i32) -> f32
    macro.yield %r : f32
  };
}

/// `x * y + z` with one rounding: `fputil::multiply_add` with FMA.
fn libm_multiply_add(x : f64, y : f64, z : f64) -> f64 {
  return mlir!( inputs : (%x = x : f64, %y = y : f64, %z = z : f64), returns : f64, dialects : ["math"]) {
    %r = math.fma %x, %y, %z : f64
    macro.yield %r : f64
  };
}

/// The correctly rounded square root: `fputil::sqrt<double>`.
fn libm_sqrt_f64(x : f64) -> f64 {
  return mlir!( inputs : (%x = x : f64), returns : f64, dialects : ["math"]) {
    %r = math.sqrt %x : f64
    macro.yield %r : f64
  };
}

/// `R_LOG` from `acosh_float_constants.h`: `r` for each value of the mantissa's top 6 bits.
/// Each number here is the shortest decimal with the same bits as LLVM's hex float.
const LIBM_R_LOG : Tensor<f64, [64]> = [
1.0, 0.984375, 0.96875, 0.953125, 0.9375, 0.921875, 0.9140625, 0.8984375,
0.8828125, 0.875, 0.859375, 0.8515625, 0.8359375, 0.828125, 0.8203125, 0.8046875,
0.796875, 0.7890625, 0.78125, 0.765625, 0.7578125, 0.75, 0.7421875, 0.734375,
0.7265625, 0.71875, 0.7109375, 0.703125, 0.6953125, 0.6875, 0.6796875, 0.671875,
0.6640625, 0.65625, 0.6484375, 0.6484375, 0.640625, 0.6328125, 0.625, 0.6171875,
0.6171875, 0.609375, 0.6015625, 0.59375, 0.59375, 0.5859375, 0.578125, 0.578125,
0.5703125, 0.5625, 0.5625, 0.5546875, 0.5546875, 0.546875, 0.5390625, 0.5390625,
0.53125, 0.53125, 0.5234375, 0.5234375, 0.515625, 0.515625, 0.5078125, 0.5
];

/// `LOG_R` from `acosh_float_constants.h`: `log(1 / r)` for each `r` in `LIBM_R_LOG`.
const LIBM_LOG_R : Tensor<f64, [64]> = [
0.0, 0.015748356968139168, 0.0317486983145803, 0.048009219186360606,
0.06453852113757118, 0.0813456394539524, 0.08985632912186105, 0.1070981355563671,
0.1246424452072766, 0.13353139262452263, 0.15154989812720093, 0.16068238169047347,
0.179201429457711, 0.18859116980755003, 0.1980699137620938, 0.2173012756899814,
0.22705745063534608, 0.2369097470783577, 0.24686007793152578, 0.26706278524904525,
0.27731928541623435, 0.2876820724517809, 0.29815337231907635, 0.3087354816496133,
0.3194307707663612, 0.33024168687057687, 0.34117075740276714, 0.3522205935893521,
0.3633938941874773, 0.3746934494414107, 0.38612214526503347, 0.39768296766610944,
0.4093790074293007, 0.42121346507630353, 0.43318965612301924, 0.43318965612301924,
0.44531101665536404, 0.4575811092471784, 0.4700036292457356, 0.48258241145259567,
0.48258241145259567, 0.4953214372300254, 0.5082248420659333, 0.5212969236332861,
0.5212969236332861, 0.5345421503833068, 0.5479651707154474, 0.5479651707154474,
0.561570822771226, 0.5753641449035618, 0.5753641449035618, 0.5893503868783018,
0.5893503868783018, 0.6035350218702582, 0.6179237593223578, 0.6179237593223578,
0.6325225587435105, 0.6325225587435105, 0.6473376445286511, 0.6473376445286511,
0.6623755218931916, 0.6623755218931916, 0.6776429940239801, 0.0
];

/// `log(x)` for a positive, normal `x`, accurate enough for the single-precision functions:
/// `log_eval` from `acoshf_utils.h`, accurate version. With `x = 2^e * m`, it is
/// `e * log(2) + log(1 / r) + log(1 + dx)`, where `r` from the table makes `dx = r * m - 1`
/// small enough for a degree-6 polynomial (Sollya:
/// `fpminimax(log(1 + x)/x, 6, [|1, D...|], [-2^-7, 2^-6])`).
fn libm_log_eval(x : f64) -> f64 {
  // The top 6 bits of the mantissa pick the table entry.
  let i = ((libm_f64_to_bits(x) >> 46u64) & 63u64) as i64;
  let r = LIBM_R_LOG[i];
  let log_r = LIBM_LOG_R[i];
  return mlir!( inputs : (%x = x : f64, %r = r : f64, %log_r = log_r : f64), returns : f64, dialects : ["arith", "math"]) {
    %x_u = "arith.bitcast"(%x) : (f64) -> i64
    // x_e = ((x_u + 2^46) >> 52) - 1023: the exponent, plus one when the 8 leading bits of the
    // mantissa are all ones
    %c_round = arith.constant 70368744177664 : i64
    %c52 = arith.constant 52 : i64
    %c1023 = arith.constant 1023 : i64
    %xr = arith.addi %x_u, %c_round : i64
    %xe0 = arith.shrui %xr, %c52 : i64
    %xe = arith.subi %xe0, %c1023 : i64
    %e_x = arith.sitofp %xe : i64 to f64
    %log_2 = arith.constant 0x3FE62E42FEFA39EF : f64 // 0x1.62e42fefa39efp-1
    %r_hi = math.fma %e_x, %log_2, %log_r : f64
    // m = 1.mantissa
    %c_frac = arith.constant 4503599627370495 : i64
    %c_one = arith.constant 4607182418800017408 : i64
    %mf = arith.andi %x_u, %c_frac : i64
    %mb = arith.ori %mf, %c_one : i64
    %m = "arith.bitcast"(%mb) : (i64) -> f64
    %neg_one = arith.constant -1.0 : f64
    %dx = math.fma %r, %m, %neg_one : f64
    %k0 = arith.constant 0xBFDFFFFFFFFFFE03 : f64 // -0x1.ffffffffffe03p-2
    %k1 = arith.constant 0x3FD55555555395F9 : f64 // 0x1.55555555395f9p-2
    %k2 = arith.constant 0xBFD0000001BE5329 : f64 // -0x1.0000001be5329p-2
    %k3 = arith.constant 0x3FC9999C1BF8C3AF : f64 // 0x1.9999c1bf8c3afp-3
    %k4 = arith.constant 0xBFC554F0BA9CEE4B : f64 // -0x1.554f0ba9cee4bp-3
    %k5 = arith.constant 0x3FC1D94CD56B72D7 : f64 // 0x1.1d94cd56b72d7p-3
    %dx2 = arith.mulf %dx, %dx : f64
    %c1 = math.fma %dx, %k1, %k0 : f64
    %c2 = math.fma %dx, %k3, %k2 : f64
    %c3 = math.fma %dx, %k5, %k4 : f64
    %dx4 = arith.mulf %dx2, %dx2 : f64
    %rd = arith.addf %r_hi, %dx : f64
    %d1 = math.fma %dx2, %c1, %rd : f64
    %d2 = math.fma %dx2, %c3, %c2 : f64
    %res = math.fma %dx4, %d2, %d1 : f64
    macro.yield %res : f64
  };
}

/// The inverse hyperbolic sine, correctly rounded: `asinhf` from `asinhf.h`.
fn libm_asinhf(x : f32) -> f32 {
  let x_u = libm_f32_to_bits(x);
  let x_abs = x_u & 2147483647u32;
  let x_sign : f64 = if (x_u >> 31u32) == 0u32 {
    1.0
  } else {
    -1.0
  };
  let sign : f32 = x_sign as f32;
  // |x| <= 2^-3
  if x_abs <= 1040187392u32 {
    // |x| <= 2^-26
    if x_abs <= 847249408u32 {
      if x_abs == 0u32 {
        return x;
      }
      let xd = x as f64;
      return (xd - libm_f64_from_bits(4595172819793696085u64) * xd * xd * xd) as f32; // 0x1.5555555555555p-3
    }
    // Sollya: P = fpminimax(asinh(x)/x, [|0, 2, 4, 6, 8, 10, 12|], [|1, D...|], [0, 2^-3])
    let x_d = x as f64;
    let x_sq = x_d * x_d;
    let c0 = libm_multiply_add(x_sq, libm_f64_from_bits(4590068740215863170u64), libm_f64_from_bits(13818544856648471834u64)); // 0x1.333333330f782p-4, -0x1.555555555551ap-3
    let c1 = libm_multiply_add(x_sq, libm_f64_from_bits(4584414174696340721u64), libm_f64_from_bits(13809966571523142661u64)); // 0x1.f1c67120a7cf1p-6, -0x1.6db6dafa7f405p-5
    let c2 = libm_multiply_add(x_sq, libm_f64_from_bits(4580447041133744408u64), libm_f64_from_bits(13805473156160713939u64)); // 0x1.10450cf441118p-6, -0x1.6e4b0e52674d3p-6
    let x_4 = x_sq * x_sq;
    let x_3 = x_d * x_sq;
    let p = libm_multiply_add(x_4, libm_multiply_add(x_4, c2, c1), c0);
    return libm_multiply_add(x_3, p, x_d) as f32;
  }
  let x_a = libm_f32_from_bits(x_abs) as f64;
  // |x| >= 2^24
  if x_abs >= 1266679808u32 {
    // Infinity or NaN: itself.
    if x_abs >= 2139095040u32 {
      return x;
    }
    // Inputs where the evaluation below would round the wrong way.
    if x_abs == 1272800677u32 {
      return sign * libm_f32_from_bits(1099891531u32); // 0x1.1e0696p4f
    }
    if x_abs == 1283473196u32 {
      return sign * libm_f32_from_bits(1100332086u32); // 0x1.2b786cp4f
    }
    if x_abs == 1334835971u32 {
      return sign * libm_f32_from_bits(1102573210u32); // 0x1.6fdd34p4f
    }
    if x_abs == 1549180552u32 {
      return sign * libm_f32_from_bits(1109581987u32); // 0x1.45c146p5f
    }
    if x_abs == 1583913038u32 {
      return sign * libm_f32_from_bits(1110329889u32); // 0x1.5c9442p5f
    }
    if x_abs == 1660395610u32 {
      return sign * libm_f32_from_bits(1111981645u32); // 0x1.8efc9ap5f
    }
    if x_abs == 1700303059u32 {
      return sign * libm_f32_from_bits(1112855033u32); // 0x1.a9a3f2p5f
    }
    if x_abs == 1709079718u32 {
      return sign * libm_f32_from_bits(1113043808u32); // 0x1.af66cp5f
    }
    if x_abs == 1857136876u32 {
      return sign * libm_f32_from_bits(1115970185u32); // 0x1.08b512p6f
    }
    if x_abs == 1992165854u32 {
      return sign * libm_f32_from_bits(1117432648u32); // 0x1.35569p6f
    }
    if x_abs == 2040001290u32 {
      return sign * libm_f32_from_bits(1117948443u32); // 0x1.451436p6f
    }
    // asinh(x) = log(2 |x|)
    return (x_sign * libm_log_eval(2.0 * x_a)) as f32;
  }
  if x_abs == 1168879398u32 {
    return sign * libm_f32_from_bits(1091886949u32); // 0x1.29becap3f
  }
  if x_abs == 1238536264u32 {
    return sign * libm_f32_from_bits(1097915536u32); // 0x1.e1b92p3f
  }
  // asinh(x) = log(x + sqrt(x^2 + 1))
  return (x_sign * libm_log_eval(x_a + libm_sqrt_f64(libm_multiply_add(x_a, x_a, 1.0)))) as f32;
}

/// The inverse hyperbolic cosine, correctly rounded; NaN below 1: `acoshf` from `acoshf.h`.
fn libm_acoshf(x : f32) -> f32 {
  if x <= 1.0 {
    if x == 1.0 {
      return 0.0;
    }
    let zero : f32 = 0.0;
    return zero / zero;
  }
  let x_u = libm_f32_to_bits(x);
  let x_d = x as f64;
  // x >= 2^12
  if x_u >= 1166016512u32 {
    // Infinity or NaN: itself.
    if x_u >= 2139095040u32 {
      return x;
    }
    // acosh(x) ~ log(2x) - 1/(2x)^2, and for x > 2^26 just log(2x).
    let y = 2.0 * x_d;
    // x <= 2^26
    if x_u <= 1283457024u32 {
      if x_u == 1172071444u32 {
        return libm_f32_from_bits(1092148827u32); // 0x1.31bcb6p3f
      }
      let y_inv = 0.5 / x_d;
      return libm_multiply_add(y_inv, -y_inv, libm_log_eval(y)) as f32;
    }
    if x_u == 1283473196u32 {
      return libm_f32_from_bits(1100332086u32); // 0x1.2b786cp4f
    }
    if x_u == 1334835971u32 {
      return libm_f32_from_bits(1102573210u32); // 0x1.6fdd34p4f
    }
    if x_u == 1549180552u32 {
      return libm_f32_from_bits(1109581987u32); // 0x1.45c146p5f
    }
    if x_u == 1583913038u32 {
      return libm_f32_from_bits(1110329889u32); // 0x1.5c9442p5f
    }
    if x_u == 1700303059u32 {
      return libm_f32_from_bits(1112855033u32); // 0x1.a9a3f2p5f
    }
    if x_u == 1857136876u32 {
      return libm_f32_from_bits(1115970185u32); // 0x1.08b512p6f
    }
    if x_u == 2040001290u32 {
      return libm_f32_from_bits(1117948443u32); // 0x1.451436p6f
    }
    return libm_log_eval(y) as f32;
  }
  // acosh(x) = log(x + sqrt(x^2 - 1)) for 1 < x < 2^12
  return libm_log_eval(x_d + libm_sqrt_f64(libm_multiply_add(x_d, x_d, -1.0))) as f32;
}

/// The inverse hyperbolic tangent, correctly rounded; infinite at +-1 and NaN beyond:
/// `atanhf` from `atanhf.h`.
fn libm_atanhf(x : f32) -> f32 {
  let x_u = libm_f32_to_bits(x);
  let x_abs = x_u & 2147483647u32;
  // |x| >= 1
  if x_abs >= 1065353216u32 {
    // NaN: itself.
    if x_abs > 2139095040u32 {
      return x;
    }
    if x_abs == 1065353216u32 {
      return x / 0.0;
    }
    let zero : f32 = 0.0;
    return zero / zero;
  }
  // |x| < ~0.10
  if x_abs <= 1036779520u32 {
    // |x| <= 2^-26
    if x_abs <= 847249408u32 {
      if x_abs == 0u32 {
        return x;
      }
      let xd = x as f64;
      return (xd + libm_f64_from_bits(4599676419421066581u64) * xd * xd * xd) as f32; // 0x1.5555555555555p-2
    }
    let xdbl = x as f64;
    let x2 = xdbl * xdbl;
    // Taylor series: polyeval(x2, 0, 0x1.5555555555555p-2, 0x1.999999999999ap-3, 0x1.2492492492492p-3, 0x1.c71c71c71c71cp-4, 0x1.745d1745d1746p-4)
    let pe = libm_multiply_add(x2, libm_multiply_add(x2, libm_multiply_add(x2, libm_multiply_add(x2, libm_multiply_add(x2, libm_f64_from_bits(4591215111030249286u64), libm_f64_from_bits(4592670820000712476u64)), libm_f64_from_bits(4594314991293244562u64)), libm_f64_from_bits(4596373779694328218u64)), libm_f64_from_bits(4599676419421066581u64)), 0.0);
    return libm_multiply_add(xdbl, pe, xdbl) as f32;
  }
  let xdbl = x as f64;
  return (0.5 * libm_log_eval((1.0 + xdbl) / (1.0 - xdbl))) as f32;
}

/// `fmaf(x, y, z)`: `x * y + z` in single precision, rounded once.
fn libm_multiply_add_f32(x : f32, y : f32, z : f32) -> f32 {
  return mlir!( inputs : (%x = x : f32, %y = y : f32, %z = z : f32), returns : f32, dialects : ["math"]) {
    %r = math.fma %x, %y, %z : f32
    macro.yield %r : f32
  };
}

/// Whether the bits of an f32 are a signaling NaN: all exponent bits set, a nonzero mantissa,
/// and its top bit (the quiet bit) clear.
fn libm_f32_is_signaling_nan(x_u : u32) -> bool {
  let x_abs = x_u & 2147483647u32;
  return x_abs > 2139095040u32 && (x_abs & 4194304u32) == 0u32;
}

