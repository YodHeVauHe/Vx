/// `LOG_R` from `common_constants.h`: `-log(r)` for each `r` in `LIBM_COMMON_R`.
const LIBM_COMMON_LOG_R : Tensor<f64, [128]> = [
0.0, 0.007843177461025893, 0.015748356968139168, 0.023716526617316044,
0.0317486983145803, 0.039845908547199674, 0.048009219186360606, 0.05623971832287608,
0.06453852113757118, 0.06871389254805181, 0.07711730334443129, 0.08559193033540351,
