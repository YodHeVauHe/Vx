/// The accurate pass of `powf`, as a double-double: `powf_double_double` from `powf.h`, the
/// logarithm refined by a second table step and both polynomials in double-double.
fn libm_powf_double_double(idx_x : i64, dx : f64, y6 : f64, lo6_hi : f64, exp2_hi_mid : LibmDoubleDouble) -> LibmDoubleDouble {
  let idx2 = libm_round_even_f64(libm_multiply_add(dx, 16384.0, 64.0)) as i64;
  // Exact.
  let dx2 = libm_multiply_add(1.0 + dx, LIBM_COMMON_R2[idx2], -1.0);
  let dx_dd = LibmDoubleDouble {
    hi: dx2, lo: 0.0
  };
  // log2(1 + dx2) / dx2
  let mut p = LibmDoubleDouble {
    hi: libm_f64_from_bits(13821203156263148710u64), lo: libm_f64_from_bits(4351272168970118743u64)
  }; // -0x1.ec70af1929ca6p-3, 0x1.2d2fbd081e657p-57
  p = libm_dd_multiply_add(dx_dd, p, LibmDoubleDouble {
    hi: libm_f64_from_bits(4598869476604809890u64), lo: libm_f64_from_bits(13572541067231605528u64)
  }); // 0x1.2776c516a92a2p-2, -0x1.b5a30b3bdb318p-58
  p = libm_dd_multiply_add(dx_dd, p, LibmDoubleDouble {
    hi: libm_f64_from_bits(13823540977621238523u64), lo: libm_f64_from_bits(4355323562998062053u64)
  }); // -0x1.71547652b82fbp-2, 0x1.137b47e635be5p-56
  p = libm_dd_multiply_add(dx_dd, p, LibmDoubleDouble {
    hi: libm_f64_from_bits(4602334714382648317u64), lo: libm_f64_from_bits(4358605153478170727u64)
  }); // 0x1.ec709dc3a03fdp-2, 0x1.ce04b5140d867p-56
  p = libm_dd_multiply_add(dx_dd, p, LibmDoubleDouble {
    hi: libm_f64_from_bits(13828044577248609022u64), lo: libm_f64_from_bits(13575951341293865604u64)
  }); // -0x1.71547652b82fep-1, -0x1.777d101cf0a84p-57
  p = libm_dd_multiply_add(dx_dd, p, LibmDoubleDouble {
    hi: libm_f64_from_bits(4609176140021203710u64), lo: libm_f64_from_bits(4357082904033633760u64)
  }); // 0x1.71547652b82fep0, 0x1.777d0ffda25ep-56
  let log2_x_lo = libm_dd_quick_mult_d(dx2, p);
  let log2_x_mid = LibmDoubleDouble {
    hi: LIBM_POWF_LOG2_R_TD[3 * idx_x + 1], lo: LIBM_POWF_LOG2_R_TD[3 * idx_x]
  };
  let log2_x_m = libm_dd_add(LibmDoubleDouble {
    hi: LIBM_POWF_LOG2_R2_DD[2 * idx2 + 1], lo: LIBM_POWF_LOG2_R2_DD[2 * idx2]
  }, log2_x_mid);
  let log2_x = if libm_larger_exponent(log2_x_m.hi, log2_x_lo.hi) {
    libm_dd_add(log2_x_m, log2_x_lo)
  } else {
    libm_dd_add(log2_x_lo, log2_x_m)
  };
  let lo6_hi_dd = LibmDoubleDouble {
    hi: lo6_hi, lo: 0.0
  };
  let prod = libm_dd_quick_mult_d(y6, log2_x);
  let lo6 = if libm_larger_exponent(prod.hi, lo6_hi) {
    libm_dd_add(prod, lo6_hi_dd)
  } else {
    libm_dd_add(lo6_hi_dd, prod)
  };
  // 2^(lo6 / 64)
  let mut pp = LibmDoubleDouble {
    hi: libm_f64_from_bits(4259088384742899425u64), lo: libm_f64_from_bits(13238410538663896109u64)
  }; // 0x1.b5251ff97bee1p-78, -0x1.8483eabd9642dp-132
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4302674886669337401u64), lo: libm_f64_from_bits(13281320184314770283u64)
  }); // 0x1.62c034beb8339p-68, -0x1.0ba57164eb36bp-122
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4345970066018852569u64), lo: libm_f64_from_bits(13322521076972774527u64)
  }); // 0x1.ffcbfc588ded9p-59, -0x1.31a55719de47fp-113
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4387685337091456952u64), lo: libm_f64_from_bits(13369397596894643686u64)
  }); // 0x1.430912f86bfb8p-49, -0x1.9a447bfddc5e6p-103
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4428683852445804337u64), lo: libm_f64_from_bits(4174420041262859232u64)
  }); // 0x1.5d87fe78a6731p-40, 0x1.e84e916be83ep-97
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4468611704665296503u64), lo: libm_f64_from_bits(4221274946447384910u64)
  }); // 0x1.3b2ab6fba4e77p-31, 0x1.4fb32d240a14ep-86
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4507095012802339008u64), lo: libm_f64_from_bits(13487492629240293007u64)
  }); // 0x1.c6b08d704a0cp-23, -0x1.d33162491268fp-77
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4543779896819893647u64), lo: libm_f64_from_bits(13521464395421040091u64)
  }); // 0x1.ebfbdff82c58fp-15, -0x1.5e43a5429bddbp-69
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4577396936549218799u64), lo: libm_f64_from_bits(4330981379454631972u64)
  }); // 0x1.62e42fefa39efp-7, 0x1.abc9e3b398024p-62
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: 1.0, lo: 0.0
  });
  let rr = libm_dd_quick_mult(exp2_hi_mid, pp);
  return libm_dd_exact_add(rr.hi, rr.lo);
}

/// `x^y`, correctly rounded: `powf` from `powf.h`. `x^y = 2^(y log2 x)`: `log2 x` from the
/// `LOG2_R` tables and a polynomial, `2^(.)` from `EXP2_MID1` and a polynomial, both in double;
/// a result too near a rounding boundary is redone in double-double. Special cases: `y` of 0,
/// 1/2, 1, 2, small whole `y` computed exactly, infinities, NaNs, zeros and negative `x`.
fn libm_powf(x0 : f32, y0 : f32) -> f32 {
  let mut x = x0;
  let mut y = y0;
  let mut x_u = libm_f32_to_bits(x);
  let x_abs = x_u & 2147483647u32; // 0x7fffffff
  let y_u = libm_f32_to_bits(y);
  let y_abs = y_u & 2147483647u32; // 0x7fffffff
  if (y_abs & 524287u32) == 0u32 || y_abs > 1326907392u32 { // 0x0007ffff, 0x4f170000
    if libm_f32_is_signaling_nan(x_u) || libm_f32_is_signaling_nan(y_u) {
      return libm_f32_from_bits(2143289344u32); // 0x7fc00000
    }
    if y_abs == 0u32 {
      return 1.0;
    }
    if y_abs == 2139095040u32 { // 0x7f800000
      if x_abs > 2139095040u32 { // 0x7f800000
        return x;
      }
      if x_abs == 1065353216u32 { // 0x3f800000
        return 1.0;
      }
      if x_abs == 0u32 && y_u == 4286578688u32 { // 0xff800000
        return libm_f32_from_bits(2139095040u32); // 0x7f800000
      }
      if (x_abs < 1065353216u32) == (y_u == 4286578688u32) { // 0x3f800000, 0xff800000
        return libm_f32_from_bits(2139095040u32); // 0x7f800000
      }
      return 0.0;
    }
    if y_u == 1056964608u32 { // 0x3f000000
      if x_abs == 0u32 || x_u == 4286578688u32 { // 0xff800000
        return x * x;
      }
      let r = libm_sqrt_f32(x);
      if libm_f32_to_bits(r) != 2147483648u32 { // 0x80000000
        return r;
      }
      return 0.0;
    }
    if y_u == 1065353216u32 { // 0x3f800000
      return x;
    }
    if y_u == 1073741824u32 { // 0x40000000
      return x * x;
    }
    // A small whole y whose power fits in a double: computed exactly, rounded once.
    if libm_f32_bits_is_integer(y_u) && y_u > 1073741824u32 && y_u <= 1103101952u32 { // 0x40000000, 0x41c00000
      let mut msb : i32 = 30;
      let mut lsb : i32 = 0;
      if x_abs != 0u32 {
        msb = libm_u32_leading_zeros(x_abs) as i32;
        lsb = libm_u32_trailing_zeros(x_abs) as i32;
      }
      if msb < 8 {
        msb = 8;
      }
      if lsb > 23 {
        lsb = 23;
      }
      let extra_bits = 30 - lsb - msb;
      let iter = y as i32;
      if extra_bits * iter <= 25 {
        let x_d = x as f64;
        let mut result = x_d;
        for i in 1..iter {
          result = result * x_d;
        }
        return result as f32;
      }
    }
    if y_abs > 1326907392u32 { // 0x4f170000
      // y is NaN.
      if y_abs > 2139095040u32 { // 0x7f800000
        if x_u == 1065353216u32 { // 0x3f800000
          return 1.0;
        }
        return y;
      }
      // Huge y: only its sign and evenness matter, so 2^32 with its sign does.
      y = libm_f32_from_bits((y_u & 2147483648u32) + 1333788672u32); // 0x80000000, 0x4f800000
    }
  }
  let mut ex : i32 = -127;
  let mut sign : u64 = 0u64;
  if (x_u & 2149580799u32) == 0u32 || x_u >= 2139095040u32 || x_u < 8388608u32 { // 0x801fffff, 0x7f800000, 0x00800000
    if libm_f32_is_signaling_nan(x_u) {
      return libm_f32_from_bits(2143289344u32); // 0x7fc00000
    }
    if x_u == 1065353216u32 { // 0x3f800000
      return 1.0;
    }
    if x_u == 1073741824u32 { // 0x40000000
      return libm_exp2f(y);
    }
    if x_u == 1092616192u32 { // 0x41200000
      return libm_exp10f(y);
    }
    let x_is_neg = x_u >= 2147483648u32; // 0x80000000
    if x_abs == 0u32 {
      let out_is_neg = x_is_neg && libm_f32_bits_is_odd_integer(y_u);
      if y_u > 2147483648u32 { // 0x80000000
        if out_is_neg {
          return libm_f32_from_bits(4286578688u32); // 0xff800000
        }
        return libm_f32_from_bits(2139095040u32); // 0x7f800000
      }
      if out_is_neg {
        return -0.0;
      }
      return 0.0;
    }
    if x_abs == 2139095040u32 { // 0x7f800000
      let out_is_neg = x_is_neg && libm_f32_bits_is_odd_integer(y_u);
      if y_u >= 2147483648u32 { // 0x80000000
        if out_is_neg {
          return -0.0;
        }
        return 0.0;
      }
      if out_is_neg {
        return libm_f32_from_bits(4286578688u32); // 0xff800000
      }
      return libm_f32_from_bits(2139095040u32); // 0x7f800000
    }
    if x_abs > 2139095040u32 { // 0x7f800000
      return x;
    }
    // Subnormal: scale into the normal range.
    if x_abs < 8388608u32 { // 0x00800000
      ex = ex - 64;
      x = x * libm_f32_from_bits(1602224128u32); // 0x1.0p64f
    }
    if x_is_neg {
      let y_bits = libm_f32_to_bits(y);
      if !libm_f32_bits_is_integer(y_bits) {
        return libm_f32_from_bits(2143289344u32); // 0x7fc00000
      }
      x = -x;
      if libm_f32_bits_is_odd_integer(y_bits) {
        sign = 9223372036854775808u64;
      }
    }
  }
  x_u = libm_f32_to_bits(x);
  ex = ex + (x_u >> 23u32) as i32;
  let e_x = ex as f64;
  let x_mant = x_u & 8388607u32; // 0x007fffff
  let idx_x = (x_mant >> 16u32) as i64;
  let m_x = libm_f32_from_bits(x_mant | 1065353216u32); // 0x3f800000
  // Exact.
  let dx = libm_multiply_add_f32(m_x, LIBM_COMMON_R[idx_x], -1.0) as f64;
  // log2(1 + dx) / dx
  let dx2 = dx * dx;
  let c0 = libm_multiply_add(dx, libm_f64_from_bits(13828044577248606727u64), libm_f64_from_bits(4609176140021203710u64)); // -0x1.71547652b7a07p-1, 0x1.71547652b82fep0
  let c1 = libm_multiply_add(dx, libm_f64_from_bits(13823540978543388361u64), libm_f64_from_bits(4602334714383404465u64)); // -0x1.715479c2266c9p-2, 0x1.ec709dc458db1p-2
  let c2 = libm_multiply_add(dx, libm_f64_from_bits(13821119690132881751u64), libm_f64_from_bits(4598869470438357232u64)); // -0x1.e7b2178870157p-3, 0x1.2776ae1ddf8fp-2
  let p = libm_multiply_add(dx2, libm_multiply_add(dx2, c2, c1), c0);
  let s = libm_multiply_add(dx, p, LIBM_COMMON_LOG2_R[idx_x] + e_x);
  // Exact.
  let y6 = (y * 64.0) as f64;
  let hm = libm_round_even_f64(s * y6);
  // Exact.
  let lo6_hi = libm_multiply_add(y6, e_x + LIBM_POWF_LOG2_R_TD[3 * idx_x + 2], -hm);
  let lo6 = libm_multiply_add(y6, libm_multiply_add(dx, p, LIBM_POWF_LOG2_R_TD[3 * idx_x + 1]), lo6_hi);
  let mut hm_i = hm as i64;
  if hm_i < -32768 {
    hm_i = -32768;
  }
  if hm_i > 32768 {
    hm_i = 32768;
  }
  let idx_y = hm_i & 63;
  let exp_hi_i = (hm_i >> 6) << 52;
  let exp_mid_i = libm_f64_to_bits(LIBM_EXP2_MID1[3 * idx_y + 2]) as i64;
  let exp2_hi_mid = libm_f64_from_bits(((exp_hi_i + exp_mid_i) as u64) + sign);
  // 2^(lo6 / 64)
  let lo6_sqr = lo6 * lo6;
  let d0 = libm_multiply_add(lo6, libm_f64_from_bits(4577396936549218799u64), 1.0); // 0x1.62e42fefa39efp-7
  let d1 = libm_multiply_add(lo6, libm_f64_from_bits(4507095012802519656u64), libm_f64_from_bits(4543779896819884602u64)); // 0x1.c6b08d7076268p-23, 0x1.ebfbdff82a23ap-15
  let d2 = libm_multiply_add(lo6, libm_f64_from_bits(4428683787439195205u64), libm_f64_from_bits(4468611712252687499u64)); // 0x1.5d870c4d84445p-40, 0x1.3b2ad33f8b48bp-31
  let pp = libm_multiply_add(lo6_sqr, libm_multiply_add(lo6_sqr, d2, d1), d0);
  let r = pp * exp2_hi_mid;
  // Far enough from a rounding boundary, r is right.
  let r_u = libm_f64_to_bits(r);
  let r_upper = libm_f64_from_bits(r_u + 64u64) as f32;
  let r_lower = libm_f64_from_bits(r_u - 64u64) as f32;
  if r_upper == r_lower {
    return r_upper;
  }
  let mut mid_lo : f64 = 0.0;
  if idx_y != 0 {
    mid_lo = libm_f64_from_bits((exp_hi_i + (libm_f64_to_bits(LIBM_EXP2_MID1[3 * idx_y + 1]) as i64)) as u64);
  }
  let r_dd = libm_powf_double_double(idx_x, dx, y6, lo6_hi, LibmDoubleDouble {
    hi: exp2_hi_mid, lo: mid_lo
  });
  return libm_dd_nudge(r_dd, 268435455u64) as f32;
}

/// The correctly rounded square root of an f32.
fn libm_sqrt_f32(x : f32) -> f32 {
  return mlir!( inputs : (%x = x : f32), returns : f32, dialects : ["math"]) {
    %r = math.sqrt %x : f32
    macro.yield %r : f32
  };
}
